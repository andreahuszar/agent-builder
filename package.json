{
  "name": "invoice-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-safe.js",
    "dev:turbo": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "node scripts/force-sync-schema-v2.js && next start",
    "deploy": "node scripts/force-sync-schema-v2.js",
    "db:migrate:sql": "node scripts/migrate-sql.js",
    "db:sync:enhanced": "node scripts/extract-local-schema.js && node scripts/force-sync-schema-v2.js",
    "db:sync:dry-run": "node scripts/force-sync-schema-v2.js --dry-run",
    "db:validate": "node scripts/validate-schema.js",
    "lint": "next lint",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "db:dev": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "node scripts/backup-database.js",
    "db:restore": "node scripts/restore-database.js",
    "db:export": "node scripts/export-local-data.js",
    "db:production:import": "node scripts/import-to-production.js",
    "db:production:seed": "node scripts/seed-production-from-local.js",
    "db:production:seed-sample": "node scripts/seed-production-sample-data.js",
    "db:production:migrate": "node scripts/production-migration.js",
    "db:production:wipe": "node scripts/wipe-production.js",
    "db:sync:data": "node scripts/sync-data-to-railway.js",
    "db:sync:data:dry-run": "node scripts/sync-data-to-railway.js --dry-run",
    "db:sync:data:full": "node scripts/sync-data-to-railway.js --full",
    "db:sync:info": "node scripts/lib/dependency-resolver.js",
    "db:sync:status": "node scripts/lib/sync-tracker.js",
    "db:sync:full": "node scripts/full-data-sync.js",
    "db:sync:full:dry": "node scripts/full-data-sync.js --dry-run",
    "db:sync:full:clean": "node scripts/full-data-sync.js --truncate --cascade",
    "db:sync:verify": "node scripts/full-data-sync.js --dry-run --verbose",
    "demo:setup": "./scripts/demo-quickstart.sh",
    "demo:sync": "node scripts/setup-demo-environment.js",
    "demo:sync:dry": "node scripts/setup-demo-environment.js --dry-run",
    "demo:sync:schema": "node scripts/setup-demo-environment.js --schema-only",
    "demo:sync:data": "node scripts/setup-demo-environment.js --data-only",
    "demo:refresh": "node scripts/setup-demo-environment.js --data-only",
    "postinstall": "prisma generate",
    "check:build": "prisma generate && next build",
    "check:types": "tsc --noEmit",
    "check:all": "npm run check:types && npm run lint",
    "pre-push": "./scripts/pre-push-check.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/js-cookie": "^3.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.539.0",
    "mammoth": "^1.11.0",
    "next": "^16.1.4",
    "openai": "^5.16.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.149",
    "pg": "^8.16.3",
    "prisma": "^6.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.2",
    "@types/node": "^20.19.30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
