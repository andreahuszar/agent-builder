# Demo Environment Configuration Template
# Copy this file to .env.local when working on demo-event branch

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Local Development Database (Docker)
# Leave this as-is for local development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/xelix_invoice_dev

# Production Railway Database (READ ONLY - for syncing)
# Get from Railway Dashboard → Production Database → Variables → DATABASE_URL
RAILWAY_DATABASE_URL=postgresql://postgres:PASSWORD@nozomi.proxy.rlwy.net:PORT/railway

# Demo Railway Database (NEW - for demo environment)
# Create new PostgreSQL service in Railway Dashboard
# Get from Railway Dashboard → Demo Database → Variables → DATABASE_URL
DEMO_DATABASE_URL=postgresql://postgres:PASSWORD@DEMO_HOST.railway.app:PORT/railway

# ============================================
# AI SERVICES
# ============================================

# Anthropic API Key (Claude AI)
# Same as production - get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenAI API Key (GPT-4)
# Same as production - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# MOCK DATA CONFIGURATION
# ============================================

# Enable mock data service for faster development
# Set to 'true' for demos to have consistent test data
# Set to 'false' to use real database data
USE_MOCK_DATA=true

# Enable debug logging for mock data service
# Set to 'true' to see which mock functions are being called
DEBUG_MOCK=false

# ============================================
# FILE STORAGE (Railway Volumes)
# ============================================

# Upload directory (where invoice PDFs/images are stored)
# For Railway deployment, this should match your Volume mount path
# Default: /app/uploads
UPLOAD_DIR=/app/uploads

# Maximum file upload size (in bytes)
# Default: 10MB
MAX_FILE_SIZE=10485760

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Node environment
NODE_ENV=development

# Application URL (for Railway deployment)
# Leave empty for local development
# Set in Railway dashboard for demo deployment
# NEXT_PUBLIC_APP_URL=https://your-demo-app.railway.app

# API Rate Limiting (optional)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=60000

# ============================================
# DEMO-SPECIFIC CONFIGURATION
# ============================================

# Demo mode flag (optional - use for special demo features)
# DEMO_MODE=true

# Demo event name (for tracking/logging)
# DEMO_EVENT_NAME="Company Event 2025"

# Demo user credentials (if implementing demo login)
# DEMO_USER_EMAIL=demo@xelix.com
# DEMO_USER_PASSWORD=demo123

# ============================================
# INSTRUCTIONS FOR SETUP
# ============================================

# 1. Create new PostgreSQL service in Railway Dashboard
#    - Name: xelix-invoice-demo
#    - Copy DATABASE_URL to DEMO_DATABASE_URL above

# 2. Run database setup script:
#    node scripts/setup-demo-environment.js

# 3. Create Railway Volume for file storage:
#    - Railway Dashboard → New Service → Empty Service
#    - Name: xelix-invoice-demo-files
#    - Add Volume with mount path: /app/uploads

# 4. Deploy demo-event branch to Railway:
#    - Connect branch to Railway service
#    - Set environment variables in Railway Dashboard
#    - Use ${{xelix-invoice-demo.DATABASE_PRIVATE_URL}} for DATABASE_URL

# 5. Test the deployment:
#    - Visit demo app URL
#    - Test /api/test-db endpoint
#    - Verify data is present

# ============================================
# NOTES
# ============================================

# - Keep this file (.env.demo.example) in version control
# - Do NOT commit .env.local with actual credentials
# - Add .env.local to .gitignore (should already be there)
# - For Railway deployment, set variables in Railway Dashboard
# - Never use production database in demo environment
# - Always use DEMO_DATABASE_URL for demo deployments
